{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://360-geo.github.io/stac-panorama/v1.0.0/schema.json#",
  "title": "Panorama Extension",
  "description": "STAC Panorama Extension for STAC Items and STAC Collections: the projection and orientation of 360° panoramas.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://360-geo.github.io/stac-panorama/v1.0.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Collection",
        "Feature"
      ]
    },
    "assets": {
      "$comment": "This validates the fields in Item and Collection Assets, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fields"
      }
    },
    "asset_templates": {
      "$comment": "This validates the fields in asset templates of the Tiled Assets extension, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fields"
      }
    },
    "assetTemplates": {
      "$comment": "This validates the fields in asset templates of the Asset Templates extension, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fields"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "This is the schema for STAC Items.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "allOf": [
            {
              "required": [
                "pano:projection_type"
              ]
            },
            {
              "$ref": "#/definitions/fields"
            }
          ]
        }
      }
    },
    {
      "$comment": "This is the schema for STAC Collections: summaries and item asset definitions.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "summaries": {
          "$ref": "#/definitions/summaries"
        },
        "item_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/fields"
          }
        }
      }
    }
  ],
  "definitions": {
    "pano:projection_type": {
      "title": "Projection type",
      "description": "How the image maps directions to pixels.",
      "type": "string",
      "enum": [
        "equirectangular"
      ]
    },
    "pano:yaw": {
      "title": "Yaw",
      "description": "Heading of the reference direction in degrees, clockwise from the north axis of pers:crs (true north by default).",
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "pano:pitch": {
      "title": "Pitch",
      "description": "Elevation of the reference direction above the horizontal in degrees. Positive looks up.",
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "pano:roll": {
      "title": "Roll",
      "description": "Rotation of the image about the reference direction in degrees. Positive when the right-hand edge tilts down.",
      "type": "number",
      "exclusiveMinimum": -180,
      "maximum": 180
    },
    "fields": {
      "$comment": "The fields of this extension. They are not required here, because this definition is referenced wherever they may appear.",
      "type": "object",
      "properties": {
        "pano:projection_type": {
          "$ref": "#/definitions/pano:projection_type"
        },
        "pano:yaw": {
          "$ref": "#/definitions/pano:yaw"
        },
        "pano:pitch": {
          "$ref": "#/definitions/pano:pitch"
        },
        "pano:roll": {
          "$ref": "#/definitions/pano:roll"
        }
      },
      "patternProperties": {
        "^(?!pano:)": {
          "$comment": "Fields without the pano: prefix are not validated here."
        }
      },
      "additionalProperties": false
    },
    "summaries": {
      "$comment": "Summaries as a list of values, or as a range for the angles.",
      "type": "object",
      "properties": {
        "pano:projection_type": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pano:projection_type"
          }
        },
        "pano:yaw": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/pano:yaw"
          },
          "properties": {
            "minimum": {
              "$ref": "#/definitions/pano:yaw"
            },
            "maximum": {
              "$ref": "#/definitions/pano:yaw"
            }
          }
        },
        "pano:pitch": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/pano:pitch"
          },
          "properties": {
            "minimum": {
              "$ref": "#/definitions/pano:pitch"
            },
            "maximum": {
              "$ref": "#/definitions/pano:pitch"
            }
          }
        },
        "pano:roll": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/pano:roll"
          },
          "properties": {
            "minimum": {
              "$ref": "#/definitions/pano:roll"
            },
            "maximum": {
              "$ref": "#/definitions/pano:roll"
            }
          }
        }
      },
      "patternProperties": {
        "^(?!pano:)": {
          "$comment": "Summaries without the pano: prefix are not validated here."
        }
      },
      "additionalProperties": false
    }
  }
}
